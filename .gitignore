# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Ignore everything
*

# Except these files/folders
!.gitignore
!README.md
!.env.example
!LICENSE
!package.json
!package-lock.json
!index.html
!vite.config.js

# Source code
!src/
!src/**

# Public assets
!public/
!public/**

# Docs
!docs/
!docs/**

# Environment files (keep only example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
